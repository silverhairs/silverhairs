{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "silverhairs",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
