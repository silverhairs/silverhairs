---
import BaseLayout from "../layouts/BaseLayout.astro";
import FolioMark from "../components/FolioMark.astro";
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <div class="page folio-page not-found">
    <FolioMark number="404" label="Missing" />
    <div class="folio-body">
      <h1>Not in the index.</h1>
      <p>The page may have moved, or it may never have existed.</p>
      <a class="text-link" href="/">Return to index <span aria-hidden="true">→</span></a>
    </div>
  </div>
</BaseLayout>
